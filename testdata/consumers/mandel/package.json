  "scripts": {
    "prepare": "ts-patch install || true",
    "postinstall": "zx scripts/install-raw-apps.mjs",
    "build": "export NODE_OPTIONS='--max-old-space-size=4096' && nest build && vike build && pnpm build:outlook-pane",
    "build:outlook-pane": "MANDEL_ADDONS_DIR=${MANDEL_ADDONS_DIR:-../mandel-addons}; if test -d \"$MANDEL_ADDONS_DIR/outlook\"; then MANDEL_ROOT=\"$PWD\" VITE_MANDEL_BASE_URL=${VITE_MANDEL_BASE_URL:-/} pnpm --dir \"$MANDEL_ADDONS_DIR\" --filter @mandel-addons/outlook build; else echo \"[build:outlook-pane] $MANDEL_ADDONS_DIR/outlook not found - skipping\"; fi",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "DEV_HOST=${DEV_HOST:-dev.local.mandel.ai} concurrently -r -k 'PORT=4000 PROXY_PORT=3000 HMR_HOST=$DEV_HOST MANDEL_TRUST_PROXY=${MANDEL_TRUST_PROXY:-true} nest start --watch --env-file=.env.local' 'caddy run --config Caddyfile.dev >/dev/null 2>&1' 'MANDEL_ADDONS_DIR=${MANDEL_ADDONS_DIR:-../mandel-addons}; if test -d \"$MANDEL_ADDONS_DIR/outlook\"; then MANDEL_ROOT=\"$PWD\" pnpm --dir \"$MANDEL_ADDONS_DIR\" --filter @mandel-addons/outlook start; else echo \"[outlook vite] $MANDEL_ADDONS_DIR/outlook not found — skipping\"; tail -f /dev/null; fi'",
    "start:debug": "nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "wmill:tsx-to-ts": "tsx-to-ts 'shared/**/*.tsx'",
    "wmill:pull": "cd windmill/ && wmill sync pull --excludes '**/*.schedule.yaml'",
    "wmill:pull:local": "./scripts/wmill-pull-local.sh",
    "wmill:push:all": "./scripts/wmill-push-all.sh",
    "wmill:regenerate-locks": "./scripts/regenerate-wmill-locks.sh",
    "wmill:regenerate-inline-locks": "./scripts/regenerate-wmill-inline-locks.sh",
    "wmill:push": "./scripts/wmill-push.sh",
    "wmill:schedules": "tsx scripts/materialize-windmill-schedules.ts",
    "wmill:schedules:check": "tsx scripts/materialize-windmill-schedules.ts --workspace windmill-local --check",
    "wmill:client": "windmill-ts generate shared/f/lib/windmill/client.ts && node scripts/sort-windmill-client.mjs",
    "wmill:cancel-jobs": "DOTENV_CONFIG_PATH='.env.local' node -r dotenv/config scripts/cancel-jobs-matching-filter.js",
    "wmill-local": "./scripts/wmill-local.sh",
    "health-check": "tsx scripts/health-check-pages.ts",
    "test:unit": "tsx scripts/run-unit-tests.ts",
    "test:unit:watch": "vitest --project=unit --project=harness-unit",
    "check:build-types": "tsc -p tsconfig.build.json --noEmit --incremental false",
    "check:cases-phase2-types": "tsc -p tsconfig.exceptions-phase2-tests.json --noEmit --incremental false",
    "check:ci-proof-types": "tsc -p tsconfig.ci-proof-tests.json --noEmit --incremental false",
    "check:playbook-map-types": "tsc -p tsconfig.playbook-map.json --noEmit --incremental false",
    "test:integration": "tsx integration-tests/run-all.ts",
    "test:feature": "vitest run --config integration-tests/vitest.config.ts integration-tests/feature",
    "check:llm-attribution": "tsx scripts/check-llm-attribution.ts",
    "build:legacy-inspect-child": "node scripts/build-legacy-inspect-child.mjs",
    "check:legacy-inspect-child": "node scripts/build-legacy-inspect-child.mjs --check",
    "check:migration-wrappers": "tsc -p tsconfig.migration-wrappers.json",
    "check:supplier-branch-attribution": "tsx scripts/check-supplier-branch-attribution.ts",
    "test:supplier-branch-attribution-eval": "vitest run shared/f/lib/suppliers/branch_attribution/eval.test.ts",
    "check:llm-types": "tsc --noEmit -p tsconfig.llm-types.json",
    "atlas:gen-triggers": "node scripts/atlas-triggers/generate.mjs",
    "atlas:check-triggers": "node scripts/atlas-triggers/generate.mjs --check"
  },
